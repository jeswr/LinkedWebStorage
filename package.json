{
  "name": "@solid/community-server-lws",
  "version": "0.1.0-alpha.0",
  "description": "Linked Web Storage support for the Community Solid Server",
  "keywords": [
    "solid",
    "linked-web-storage",
    "lws",
    "community-solid-server",
    "componentsjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CommunitySolidServer/LinkedWebStorage.git"
  },
  "bugs": {
    "url": "https://github.com/CommunitySolidServer/LinkedWebStorage/issues"
  },
  "homepage": "https://github.com/CommunitySolidServer/LinkedWebStorage#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "config",
    "dist"
  ],
  "engines": {
    "node": ">=22.1.0"
  },
  "lsd:module": "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server-lws",
  "lsd:components": "dist/components/components.jsonld",
  "lsd:contexts": {
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server-lws/^0.0.0/components/context.jsonld": "dist/components/context.jsonld"
  },
  "lsd:importPaths": {
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server-lws/^0.0.0/components/": "dist/components/",
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server-lws/^0.0.0/config/": "config/",
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server-lws/^0.0.0/dist/": "dist/"
  },
  "scripts": {
    "build": "npm run build:ts && npm run build:components",
    "build:components": "componentsjs-generator -s src -c dist/components -r lws -i .componentsignore",
    "build:ts": "tsc",
    "lint": "npm run lint:eslint && npm run lint:markdown",
    "lint:eslint": "eslint . --cache --max-warnings 0",
    "lint:markdown": "markdownlint-cli2",
    "prepare": "npm run build",
    "start": "community-solid-server -m . -c config/lws.json",
    "test": "npm run test:ts && npm run test:unit && npm run test:integration",
    "test:integration": "jest test/integration",
    "test:ts": "tsc -p test --noEmit",
    "test:unit": "jest test/unit",
    "validate": "componentsjs-compile-config urn:solid-server:default:Initializer -m . -c config/lws.json -f > /dev/null"
  },
  "peerDependencies": {
    "@solid/community-server": "^8.0.0-alpha.3"
  },
  "dependencies": {
    "@rdfjs/types": "^2.0.1",
    "@solidlab/policy-engine": "^0.0.2",
    "asynchronous-handlers": "^1.0.2",
    "cross-fetch": "^4.0.0",
    "global-logger-factory": "^1.0.0",
    "jose": "^5.1.3",
    "n3": "^2.0.0",
    "rdf-vocabulary": "^1.0.1"
  },
  "devDependencies": {
    "@solid/community-server": "github:jeswr/CommunitySolidServer#feat/next-major-upstream-fixes",
    "@swc/jest": "^0.2.39",
    "@tsconfig/node20": "^20.1.6",
    "@types/fs-extra": "^11.0.2",
    "@types/jest": "^30.0.0",
    "@types/n3": "^1.21.1",
    "@types/node": "^20.19.13",
    "componentsjs": "^6.4.0",
    "componentsjs-generator": "^4.3.0",
    "eslint": "^9.35.0",
    "fs-extra": "^11.1.1",
    "jest": "^30.1.3",
    "jest-rdf": "^2.0.0",
    "markdownlint-cli2": "^0.23.3",
    "node-mocks-http": "^1.18.1",
    "opinionated-eslint-config": "0.2.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  }
}
